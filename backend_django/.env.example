# ==============================================================================
# Simatrix Academy PDF Tools — Django Environment Configuration Template
# ==============================================================================

# Security
DJANGO_SECRET_KEY=change-this-in-production-to-a-random-secret-key-at-least-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (MySQL 8.x)
DB_ENGINE=django.db.backends.mysql
DB_NAME=pdf_tool
DB_USER=root
DB_PASSWORD=Sakthi@10
DB_HOST=127.0.0.1
DB_PORT=3306

# Storage Paths (Configurable outside public web root)
STORAGE_ROOT=storage

# Google OAuth2 Credentials (Future Auth Phase)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend Origin for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
